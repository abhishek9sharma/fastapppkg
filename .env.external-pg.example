# Copy this file to .env and fill in your existing Postgres details.
# Used by: docker compose -f docker-compose.external-pg.yaml --env-file .env up

# Host visible from inside Docker containers.
# Mac / Windows Docker Desktop: host.docker.internal resolves to your machine.
# Linux: host.docker.internal also works via the extra_hosts gateway entry.
# Remote Postgres: use the actual hostname or IP.
POSTGRES_HOST=host.docker.internal

POSTGRES_PORT=5432

# The user must have CREATE DATABASE privilege so temporal-migrate can
# create the "temporal" and "temporal_visibility" databases.
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
